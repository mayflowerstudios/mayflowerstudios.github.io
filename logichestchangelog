<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LogiChest Changelog • Mayflower Studios</title>
  <style>
    :root{
      --bg1:#070b14;
      --bg2:#0c1224;
      --card:rgba(255,255,255,.06);
      --border:rgba(255,255,255,.12);
      --text:#e5e7eb;
      --muted:#a3a3a3;
      --accent:#a78bfa;
      --accent2:#38bdf8;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color:var(--text);
      background:
        radial-gradient(900px 520px at 18% 12%, rgba(167,139,250,.18), transparent 60%),
        radial-gradient(900px 520px at 82% 18%, rgba(56,189,248,.14), transparent 60%),
        linear-gradient(180deg, var(--bg1), var(--bg2));
      min-height:100vh;
    }
    a{color:inherit}
    .wrap{
      width:min(1100px, 92vw);
      margin:0 auto;
      padding:26px 0 40px;
    }

    /* Top bar */
    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      padding:14px 16px;
      border:1px solid var(--border);
      border-radius:16px;
      background:rgba(0,0,0,.18);
      backdrop-filter: blur(10px);
      box-shadow: 0 18px 60px rgba(0,0,0,.35);
    }
    .brand{
      display:flex;
      flex-direction:column;
      gap:2px;
    }
    .brand strong{
      font-size:14px;
      letter-spacing:.4px;
      text-transform:uppercase;
      opacity:.95;
    }
    .brand span{
      font-size:12px;
      color:var(--muted);
    }
    .nav{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      justify-content:flex-end;
    }
    .pill{
      text-decoration:none;
      padding:10px 12px;
      border-radius:999px;
      border:1px solid var(--border);
      background:rgba(255,255,255,.04);
      color:var(--text);
      font-weight:600;
      font-size:13px;
      transition: transform .12s ease, filter .12s ease;
    }
    .pill:hover{ transform: translateY(-1px); filter:brightness(1.03); }

    /* Hero */
    .hero{
      margin-top:16px;
      padding:22px 18px;
      border:1px solid var(--border);
      border-radius:18px;
      background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
      box-shadow: 0 18px 60px rgba(0,0,0,.35);
    }
    .hero h1{
      margin:0 0 6px;
      font-size:clamp(28px, 3.5vw, 42px);
      letter-spacing:.2px;
    }
    .subtitle{
      margin:0;
      color:var(--muted);
      line-height:1.55;
      max-width: 80ch;
    }

    .ctaRow{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:14px;
    }
    .btn{
      text-decoration:none;
      padding:12px 14px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.18);
      display:inline-flex;
      align-items:center;
      gap:10px;
      font-weight:800;
      transition: transform .12s ease, filter .12s ease;
    }
    .btn:hover{ transform: translateY(-1px); filter:brightness(1.03); }
    .btn.primary{
      color:#06121f;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
    }
    .btn.ghost{
      color:var(--text);
      background: rgba(255,255,255,.06);
      border:1px solid var(--border);
      font-weight:700;
    }

    /* Entries */
    .card{
      margin-top:16px;
      padding:18px;
      border:1px solid var(--border);
      border-radius:18px;
      background:rgba(255,255,255,.05);
      box-shadow: 0 14px 40px rgba(0,0,0,.3);
    }
    .entry{
      border:1px solid var(--border);
      background: rgba(0,0,0,.18);
      border-radius:16px;
      padding:14px;
      margin-top:12px;
    }
    .entryTop{
      display:flex;
      justify-content:space-between;
      flex-wrap:wrap;
      gap:10px;
    }
    .version{
      font-weight:900;
      display:flex;
      gap:10px;
    }
    .tag{
      font-size:12px;
      padding:4px 10px;
      border-radius:999px;
      border:1px solid var(--border);
      background: rgba(255,255,255,.05);
    }
    .date{
      font-size:12px;
      color:var(--muted);
    }

    .grid2{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:12px;
      margin-top:10px;
    }
    @media (max-width: 800px){
      .grid2{ grid-template-columns: 1fr; }
    }
    .box{
      border:1px solid var(--border);
      background: rgba(255,255,255,.03);
      border-radius:14px;
      padding:12px;
    }
    ul{
      margin:0;
      padding-left:18px;
      color:var(--muted);
      line-height:1.7;
    }

    footer{
      margin-top:18px;
      text-align:center;
      color:rgba(255,255,255,.55);
      font-size:12px;
    }
  </style>
</head>
<body>
  <div class="wrap">

    <div class="topbar">
      <div class="brand">
        <strong>Mayflower Studios</strong>
        <span>Minecraft mods • tools • cozy chaos</span>
      </div>
      <div class="nav">
        <a class="pill" href="index.html">🏠 Home</a>
        <a class="pill" href="logichest.html">🧠 LogiChest</a>
      </div>
    </div>

    <section class="hero">
      <h1>🧾 LogiChest Changelog</h1>
      <p class="subtitle">Every update, bug fix, and balance tweak for the LogiChest system.</p>
      <div class="ctaRow">
        <a class="btn primary" href="#">📦 Download / Releases</a>
        <a class="btn ghost" href="logichest.html">↩ Back to LogiChest</a>
      </div>
    </section>

    <section class="card">

      <div class="entry">
        <div class="entryTop">
          <div class="version">
            v0.0.0
            <span class="tag">Latest</span>
            <span class="tag">Forge 1.20.1</span>
          </div>
          <div class="date">January 15, 2026</div>
        </div>
        <div class="grid2">
          <div class="box">
            <h3>✨ Added</h3>
            <ul>
              <li>New hub UI layout</li>
              <li>Sorter capacity display</li>
            </ul>
          </div>
          <div class="box">
            <h3>🛠 Fixed</h3>
            <ul>
              <li>Sorter linking desync</li>
              <li>Keys not transferring properly</li>
            </ul>
          </div>
          <div class="box">
            <h3>⚖️ Changed</h3>
            <ul>
              <li>Improved item routing logic</li>
            </ul>
          </div>
          <div class="box">
            <h3>⚠️ Known Issues</h3>
            <ul>
              <li>Large networks may need chunk loaders</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Copy this block for each new version -->
      <div class="entry">
        <div class="entryTop">
          <div class="version">
            v0.0.0
            <span class="tag">Forge 1.20.1</span>
          </div>
          <div class="date">January 01, 2026</div>
        </div>
        <div class="grid2">
          <div class="box">
            <h3>✨ Added</h3>
            <ul><li>(placeholder)</li></ul>
          </div>
          <div class="box">
            <h3>🛠 Fixed</h3>
            <ul><li>(placeholder)</li></ul>
          </div>
          <div class="box">
            <h3>⚖️ Changed</h3>
            <ul><li>(placeholder)</li></ul>
          </div>
          <div class="box">
            <h3>⚠️ Known Issues</h3>
            <ul><li>(placeholder)</li></ul>
          </div>
        </div>
      </div>

    </section>

    <footer>
      © <span id="year"></span> Mayflower Studios
    </footer>
  </div>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
</body>
</html>
