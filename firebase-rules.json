{
  "rules": {
    // ────────────────────────────────────────────────────────────────────
    //  Mayflower Studios — Realtime Database rules
    //  Covers the unified Together room system (rooms / roomInvites) plus the
    //  existing account, friends, presence, chat, and per-type room data.
    //
    //  Paste this whole object into Firebase Console → Realtime Database →
    //  Rules, then Publish. Adjust only if you've added trees not listed here
    //  — anything without an explicit rule inherits ".read"/".write": false.
    // ────────────────────────────────────────────────────────────────────

    // ===== Accounts & profiles =====
    // Profiles are world-readable (names/avatars show up in chat, room lists,
    // friend cards). Only the owner can write their own profile.
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    // Username → uid index. Readable so lookups work; a handle can be claimed
    // only if it's free, or already points at you (lets you re-save it).
    "usernames": {
      ".read": true,
      "$handle": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid || newData.val() === auth.uid)"
      }
    },

    // ===== Friends & requests =====
    // You read your own friends list. A friendship edge can be written by
    // either party (so accept can write both directions; remove can clear both).
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)"
        }
      }
    },
    // Incoming requests live under the recipient. The sender writes the request
    // into your inbox; you (the recipient) can clear it on accept/decline.
    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)"
        }
      }
    },

    // ===== Presence / status / typing =====
    "status": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "dmTyping": {
      "$pair": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      }
    },

    // ===== Unified room registry =====
    // A room's METADATA (name, type, visibility, owner, invites, members) is
    // readable by signed-in users. The hub filters the list client-side to what
    // you should see (public + friends' + invited). Note: because RTDB can't
    // friend-check a whole-list read, the *existence* of a friends-only/private
    // room's name is technically discoverable by a determined reader — but the
    // actual EXPERIENCE (video state, chat, drawings, date-night notes) lives
    // under watch/ together/ datenight/ and is gated separately below, and
    // entry is enforced by canEnter() before any of that loads.
    //
    //   • create: only the owner, and only writing themselves as owner.
    //   • edit:   only the owner (name / visibility / lastActive / members).
    //   • invites: the owner adds/removes; an invitee can remove only their own
    //              invite (declining). members: you may add yourself on entry.
    //   • delete: only the owner.
    "rooms": {
      ".read": "auth != null",
      "$id": {
        // Create or replace the whole room node: must be the owner, and the
        // owner field must point at you. Delete (newData null) restricted to
        // the existing owner.
        ".write": "auth != null && ( (!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid) )",

        "owner":         { ".validate": "newData.isString()" },
        "type":          { ".validate": "newData.val() === 'watch' || newData.val() === 'games' || newData.val() === 'date'" },
        "vis":           { ".validate": "newData.val() === 'public' || newData.val() === 'friends' || newData.val() === 'private'" },
        "name":          { ".validate": "newData.isString() && newData.val().length <= 64" },
        "ownerName":     { ".validate": "newData.isString()" },
        "ownerUsername": { ".validate": "newData.isString()" },
        "t":             { ".validate": "newData.isNumber()" },

        // lastActive: owner OR any present member may bump it (keeps the lobby
        // "recently active" sort honest without opening up the rest of the node).
        "lastActive": {
          ".write": "auth != null && (data.parent().child('owner').val() === auth.uid || root.child('rooms/'+$id+'/members/'+auth.uid).exists())",
          ".validate": "newData.isNumber()"
        },

        // members: you may write your OWN membership timestamp on entry; the
        // owner may write anyone's (e.g. seeding themselves at create time).
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('owner').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          }
        },

        // invites: owner manages everyone; an invitee may remove only their own
        // entry (decline). Nobody else can write here.
        "invites": {
          "$uid": {
            ".write": "auth != null && (data.parent().parent().child('owner').val() === auth.uid || (auth.uid === $uid && !newData.exists()))"
          }
        }
      }
    },

    // Per-user invite inbox. You read your own. The room owner writes invites
    // into a friend's inbox; the invitee can clear their own (join/dismiss).
    "roomInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('rooms/'+$roomId+'/owner').val() === auth.uid)"
        }
      }
    },

    // ===== Per-type room experiences =====
    // These hold the live state. They're readable/writable by signed-in users
    // who reached the room (the page only connects after canEnter() passes).
    // Anonymous co-watching of PUBLIC rooms is still allowed (auth not required)
    // to preserve the old "share a link" behaviour for watch parties.
    "watch": {
      "$room": { ".read": true, ".write": true }
    },
    "together": {
      "$room": { ".read": true, ".write": true }
    },
    "datenight": {
      // Date night is account-only by design.
      "$room": { ".read": "auth != null", ".write": "auth != null" }
    },

    // ===== Legacy lobby (pre-overhaul rooms) =====
    // Kept readable/writable so old watch-party links still resolve. Safe to
    // delete this block once no legacy lobby rooms remain.
    "lobby": {
      ".read": true,
      "$room": { ".write": true }
    },

    // ===== Universal chat (global + DMs) =====
    // Left permissive for signed-in users, matching the existing chat.js model.
    // Tighten per your needs if you add moderation.
    "chat": {
      ".read": true,
      ".write": "auth != null"
    },
    "dm": {
      "$pair": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    // ===== Companion (virtual pet) =====
    "companion": {
      "$id": { ".read": true, ".write": "auth != null" }
    }
  }
}
