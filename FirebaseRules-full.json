{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^[a-z0-9_]+$/)"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "bannerURL": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "avatarEmoji": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "avatarType": {
          ".validate": "newData.val() === 'emoji' || newData.val() === 'photo'"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "pronouns": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "accent": {
          ".validate": "newData.isString() && (newData.val().length == 0 || newData.val().matches(/^#[0-9a-fA-F]{6}$/))"
        },
        "birthday": {
          ".validate": "newData.isString() && (newData.val().length == 0 || newData.val().matches(/^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/))"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "state": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
        },
        "last": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat": {
      "global": {
        ".read": "auth != null",
        "$msg": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid','text','t']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('t').isNumber()",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    },
    "dm": {
      "$pair": {
        ".read": "auth != null && ((root.child('friends').child(auth.uid).child($pair.replace(auth.uid + '__','').replace('__' + auth.uid,'')).exists()))",
        ".write": "auth != null && ((root.child('friends').child(auth.uid).child($pair.replace(auth.uid + '__','').replace('__' + auth.uid,'')).exists()))",
        "$msg": {
          ".validate": "newData.hasChildren(['uid','text','t']) && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('t').isNumber()",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    },
    "dmIndex": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)",
          ".validate": "newData.hasChild('t')"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$id": {
        ".read": "auth != null || data.child('vis').val() === 'public'",
        ".write": "auth != null && ( (!data.exists() && newData.child('owner').val() === auth.uid) || (data.exists() && data.child('owner').val() === auth.uid) || (data.exists() && newData.exists()) )",
        ".validate": "!newData.exists() || (newData.hasChildren(['type','vis','name','owner','t']) && (!data.exists() ? newData.child('owner').val() === auth.uid : newData.child('owner').val() === data.child('owner').val()))",
        "id": {
          ".validate": "newData.isString() && newData.val() === $id"
        },
        "type": {
          ".validate": "newData.val() === 'watch' || newData.val() === 'games' || newData.val() === 'date' || newData.val() === 'learn' || newData.val() === 'language'"
        },
        "vis": {
          ".validate": "newData.val() === 'public' || newData.val() === 'friends' || newData.val() === 'private'"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "owner": {
          ".validate": "newData.isString()"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "ownerUsername": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "lastActive": {
          ".validate": "newData.isNumber()"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('owner').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          }
        },
        "invites": {
          "$uid": {
            ".write": "auth != null && (data.parent().parent().child('owner').val() === auth.uid || newData.parent().parent().child('owner').val() === auth.uid || (auth.uid === $uid && !newData.exists()))",
            ".validate": "!newData.exists() || newData.hasChild('t')",
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$roomId": {
          ".write": "auth != null && (auth.uid === $uid || (newData.exists() && newData.child('fromUid').val() === auth.uid) || (!newData.exists() && data.child('fromUid').val() === auth.uid))",
          ".validate": "!newData.exists() || newData.hasChild('t')",
          "id": {
            ".validate": "newData.isString()"
          },
          "type": {
            ".validate": "newData.val() === 'watch' || newData.val() === 'games' || newData.val() === 'date' || newData.val() === 'learn' || newData.val() === 'language'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "fromUid": {
            ".validate": "newData.isString()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "watch": {
      "$room": {
        ".read": "root.child('rooms').child($room).child('vis').val() === 'public' || auth != null",
        ".write": "root.child('rooms').child($room).child('vis').val() === 'public' || auth != null",
        "state": {
          ".validate": "newData.hasChildren(['kind','src']) || !newData.exists()"
        },
        "presence": {
          "$client": {
            ".validate": "newData.hasChild('name') || !newData.exists()"
          }
        },
        "chat": {
          "$msg": {
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('t').isNumber()"
          }
        },
        "queue": {
          ".validate": true
        },
        "history": {
          ".validate": true
        },
        "waiting": {
          ".validate": true
        },
        "advance": {
          ".validate": true
        },
        "repeat": {
          ".validate": true
        },
        "neverStop": {
          ".validate": true
        }
      }
    },
    "together": {
      "$room": {
        ".read": "root.child('rooms').child($room).child('vis').val() === 'public' || auth != null",
        ".write": "root.child('rooms').child($room).child('vis').val() === 'public' || auth != null",
        "presence": {
          "$client": {
            ".validate": "newData.hasChild('name') || !newData.exists()"
          }
        },
        "chat": {
          "$msg": {
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 2500 && newData.child('t').isNumber()"
          }
        },
        "draw": {
          ".validate": true
        },
        "question": {
          ".validate": true
        },
        "ttt": {
          ".validate": true
        },
        "language": {
          ".validate": true
        }
      }
    },
    "datenight": {
      "$room": {
        ".read": "root.child('rooms').child($room).child('vis').val() === 'public' || auth != null",
        ".write": "root.child('rooms').child($room).child('vis').val() === 'public' || auth != null",
        "presence": {
          "$client": {
            ".validate": "newData.hasChild('name') || !newData.exists()"
          }
        },
        "notes": {
          "$id": {
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('t').isNumber()"
          }
        },
        "reasons": {
          "$id": {
            ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 160 && newData.child('t').isNumber()"
          }
        },
        "scene": {
          ".validate": true
        },
        "music": {
          ".validate": true
        },
        "drawn": {
          ".validate": true
        }
      }
    },
    "remote": {
      "$room": {
        ".read": "auth != null && data.child('owner').val() === auth.uid",
        ".write": "auth != null && ( !data.exists() ? newData.child('owner').val() === auth.uid : data.child('owner').val() === auth.uid )",
        ".validate": "!newData.exists() || newData.hasChild('owner')",
        "owner": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "hostOnline": {
          ".validate": "newData.isBoolean()"
        },
        "host": {
          "offer": {
            "$clientId": {
              ".validate": "newData.hasChildren(['type','sdp']) || !newData.exists()"
            }
          },
          "ice": {
            ".validate": true
          }
        },
        "clients": {
          "$clientId": {
            "answer": {
              ".validate": "newData.hasChildren(['type','sdp']) || !newData.exists()"
            },
            "screen": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "ice": {
              ".validate": true
            },
            "input": {
              ".validate": true
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            }
          }
        }
      }
    },
    "pets": {
      "$bondId": {
        ".read": "auth != null && ($bondId === auth.uid || $bondId.replace(auth.uid + '_','').replace('_' + auth.uid,'') !== $bondId)",
        ".write": "auth != null && ($bondId === auth.uid || $bondId.replace(auth.uid + '_','').replace('_' + auth.uid,'') !== $bondId)",
        ".validate": "newData.hasChildren(['name','lastTick','level'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "hunger": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "happy": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "energy": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "clean": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "lastTick": {
          ".validate": "newData.isNumber()"
        },
        "bornAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "userPets": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$bondId": {
          ".write": "auth != null && (auth.uid === $uid || $bondId === auth.uid || $bondId.replace(auth.uid + '_','').replace('_' + auth.uid,'') !== $bondId)",
          ".validate": "!newData.exists() || newData.hasChild('role')",
          "with": {
            ".validate": "newData.isString() || newData.val() === null"
          },
          "role": {
            ".validate": "newData.val() === 'solo' || newData.val() === 'shared'"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "petInvites": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && ((auth.uid === $fromUid && newData.exists()) || (auth.uid === $toUid))",
          ".validate": "newData.hasChild('t')",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "username": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$handle": {
        ".write": "auth != null && ( (!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid) )",
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    },
    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && ((auth.uid === $fromUid && newData.exists()) || (auth.uid === $toUid))",
          ".validate": "newData.hasChild('t')",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "username": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)",
          ".validate": "!newData.exists() || newData.hasChild('t')",
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "dmTyping": {
      "$pair": {
        ".read": "auth != null && ((root.child('friends').child(auth.uid).child($pair.replace(auth.uid + '__','').replace('__' + auth.uid,'')).exists()))",
        ".write": "auth != null && ((root.child('friends').child(auth.uid).child($pair.replace(auth.uid + '__','').replace('__' + auth.uid,'')).exists()))",
        "$uid": {
          ".validate": "newData.isNumber() || !newData.exists()"
        }
      }
    },
    "guestbooks": {
      "$uid": {
        ".read": "auth != null",
        "$postId": {
          ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() === auth.uid) || data.child('fromUid').val() === auth.uid || auth.uid === $uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromUid','fromName','text','t']) && newData.child('fromUid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('t').isNumber())",
          "fromUid": {
            ".validate": "newData.isString()"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "fromUsername": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "gifts": {
      "$uid": {
        ".read": "auth != null",
        "$giftId": {
          ".write": "auth != null && !data.exists() && newData.child('fromUid').val() === auth.uid && auth.uid !== $uid",
          ".validate": "newData.hasChildren(['fromUid','fromName','giftId','emoji','name','t']) && newData.child('fromUid').val() === auth.uid && newData.child('giftId').isString() && newData.child('giftId').val().matches(/^(flower|heart|coffee|cookie|ticket|controller|plushie|star)$/) && newData.child('emoji').isString() && newData.child('emoji').val().length <= 8 && newData.child('name').isString() && newData.child('name').val().length <= 32 && newData.child('t').isNumber()",
          "fromUid": {
            ".validate": "newData.isString()"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "fromUsername": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "giftId": {
            ".validate": "newData.isString()"
          },
          "emoji": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "relationships": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === newData.child('partnerUid').val() || auth.uid === data.child('partnerUid').val())",
        ".validate": "!newData.exists() || (newData.hasChildren(['partnerUid','partnerName','startedAt','t']) && newData.child('partnerUid').isString() && newData.child('partnerName').isString() && newData.child('partnerName').val().length <= 32 && newData.child('startedAt').isNumber() && newData.child('t').isNumber())",
        "partnerUid": {
          ".validate": "newData.isString()"
        },
        "partnerName": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "partnerUsername": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "startedAt": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "relationshipRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && ((auth.uid === $fromUid && newData.exists()) || auth.uid === $toUid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['fromName','startedAt','t']) && newData.child('fromName').isString() && newData.child('fromName').val().length <= 32 && newData.child('startedAt').isNumber() && newData.child('t').isNumber())",
          "fromName": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "fromUsername": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "craftRecipes": {
      ".read": true,
      ".indexOn": [
        "output"
      ],
      "$recipeId": {
        ".write": "(auth != null && root.child('users').child(auth.uid).child('username').exists() && ((root.child('owner').exists() && root.child('owner').val().toLowerCase() === root.child('users').child(auth.uid).child('username').val()) || root.child('admins').child(root.child('users').child(auth.uid).child('username').val()).val() === true)) || (auth != null && $recipeId.matches(/^[a-f0-9]{32}$/) && ((data.exists() && !newData.exists() && data.child('by').val() === auth.uid) || (!data.exists() && newData.exists() && newData.child('by').val() === auth.uid && !newData.hasChild('ok') && !newData.hasChild('was')) || (data.exists() && newData.exists() && newData.child('by').val() === auth.uid && !newData.hasChild('ok') && newData.child('output').val() === data.child('output').val() && newData.child('makes').val() === data.child('makes').val() && newData.child('needs').val() === data.child('needs').val() && newData.child('was').child('where').val() === data.child('where').val() && newData.child('was').child('cost').val() === data.child('cost').val())))",
        ".validate": "newData.hasChildren(['output', 'makes', 'needs', 'at'])",
        "output": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "makes": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999"
        },
        "needs": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
        },
        "where": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "cost": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() >= 1600000000000 && newData.val() <= now + 86400000"
        },
        "by": {
          ".validate": "newData.isString() && newData.val() === auth.uid && newData.val().length <= 128"
        },
        "ok": {
          ".validate": "newData.isBoolean()"
        },
        "was": {
          "where": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "cost": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "craftSources": {
      ".read": true,
      "$sourceId": {
